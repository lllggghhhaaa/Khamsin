<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Khamsin</RootNamespace>
    <AssemblyName>Khamsin</AssemblyName>
    <Description>Khamsin: build-time utility CSS for Blazor with a closed, literal class set.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- The task assemblies intentionally live under tasks/, not lib/. -->
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    <PackageId>Khamsin</PackageId>
    <Version>0.3.4</Version>
    <Authors>lllggghhhaaa</Authors>
    <Copyright>Copyright (c) 2026 Khamsin contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lllggghhhaaa/Khamsin</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lllggghhhaaa/Khamsin</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Bundles custom CSS into khamsin.css: khamsin.json's css files and referenced libraries' stylesheets are emitted in the base layer between theme and utilities, so consumers link one stylesheet, including correct merging of referenced library configs. Emits a Tailwind-compatible preflight in the base layer, extracts class attributes from render fragments declared in @code blocks, accepts fully qualified Khamsin.Cn/Khamsin.Kx calls, adds visible/invisible utilities and animate-in fade defaults, and fixes negative fraction utilities (the minus sign was dropped from -translate-x-1/2 style values) plus the attribute emitter, the metadata reader and the internal @property registrations that had gone missing.</PackageReleaseNotes>
    <PackageTags>blazor;css;utility-css;dotnet;msbuild;source-generator</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Khamsin.Blazor/Khamsin.Blazor.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Khamsin.Generators/Khamsin.Generators.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Khamsin.Build/Khamsin.Build.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Khamsin.Core/Khamsin.Core.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../Khamsin.Blazor/bin/$(Configuration)/net8.0/Khamsin.Blazor.dll" Pack="true" PackagePath="lib/net8.0" Visible="false" />
    <None Include="../Khamsin.Core/bin/$(Configuration)/netstandard2.0/Khamsin.Core.dll" Pack="true" PackagePath="lib/net8.0" Visible="false" />

    <None Include="../Khamsin.Generators/bin/$(Configuration)/netstandard2.0/Khamsin.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../Khamsin.Core/bin/$(Configuration)/netstandard2.0/Khamsin.Core.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />

    <None Include="../Khamsin.Build/bin/$(Configuration)/net8.0/Khamsin.Build.dll" Pack="true" PackagePath="tasks/net8.0" Visible="false" />
    <None Include="../Khamsin.Core/bin/$(Configuration)/netstandard2.0/Khamsin.Core.dll" Pack="true" PackagePath="tasks/net8.0" Visible="false" />

    <None Include="../Khamsin.Build/buildTransitive/Khamsin.props" Pack="true" PackagePath="buildTransitive" Visible="false" />
    <None Include="../Khamsin.Build/buildTransitive/Khamsin.targets" Pack="true" PackagePath="buildTransitive" Visible="false" />

    <None Include="../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
