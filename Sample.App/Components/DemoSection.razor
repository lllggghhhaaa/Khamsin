<section class="mb-8 rounded-xl border border-ink-200 bg-white p-5 shadow-sm">
    <h2 class="text-lg font-semibold text-ink-900">@Title</h2>
    @if (Note is { Length: > 0 })
    {
        <p class="mt-1 text-sm text-ink-500">@Note</p>
    }
    <div class="mt-4 space-y-4">@ChildContent</div>
</section>

@code {
    [Parameter]
    public string Title { get; set; } = "Section";

    [Parameter]
    public string? Note { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
