<DemoSection Title="Color targets" Note="bg, text, border, divide, ring, outline, fill, stroke, accent and caret.">
    <div class="flex flex-wrap items-center gap-3">
        <div class="rounded-lg bg-teal-600 p-3 text-xs text-white">bg + text color</div>
        <div class="rounded-lg border-2 border-ember-500 bg-white p-3 text-xs">border-ember-500</div>
        <div class="rounded-lg bg-white p-3 ring-4 ring-violet-400 text-xs">ring-violet-400</div>
        <div class="rounded-lg bg-white p-3 outline-2 outline-offset-2 outline-rose-500 text-xs">outline-rose-500</div>
        <svg viewBox="0 0 24 24" class="size-10 fill-forest-600 stroke-ink-900" role="img" aria-label="fill and stroke demo">
            <circle cx="9" cy="12" r="6" stroke-width="2" />
            <rect x="14" y="7" width="8" height="10" rx="2" fill="none" stroke-width="2" />
        </svg>
    </div>
    <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" checked class="size-4 accent-amber-500" /> accent-amber-500 checkbox
    </label>
    <input class="w-full rounded-md border border-ink-300 px-3 py-2 text-sm caret-rose-600 focus:outline-2 focus:outline-ocean-500"
           placeholder="caret-rose-600: click here and type" />
    <div class="divide-y divide-teal-300 rounded-lg border border-ink-200">
        <div class="p-2 text-sm">divide-y divide-teal-300</div>
        <div class="p-2 text-sm">second row</div>
    </div>
</DemoSection>

<DemoSection Title="Neutrals and specials" Note="white, black, transparent, current, and colors through CSS variables.">
    <div class="flex flex-wrap items-center gap-3">
        <div class="size-12 rounded border border-ink-200 bg-white"></div>
        <div class="size-12 rounded bg-black"></div>
        <div class="size-12 rounded bg-transparent border-2 border-dashed border-ink-300"></div>
        <div class="size-12 rounded bg-current text-ember-600 border border-ink-200"></div>
        <span class="text-xs text-ink-500">bg-current picks up text-ember-600</span>
    </div>
    <div class="flex flex-wrap items-center gap-3">
        <div class="size-12 rounded bg-(--brand) [--brand:#7f3bba]"></div>
        <div class="size-12 rounded bg-[#2d797c]"></div>
        <div class="size-12 rounded bg-[rgb(51_155_240)]"></div>
        <span class="text-xs text-ink-500">bg-(--brand), bg-[#2d797c], bg-[rgb(51_155_240)]</span>
    </div>
</DemoSection>

<DemoSection Title="Opacity modifiers" Note="bg-ocean-500/50 style modifiers compile to color-mix in oklab.">
    <div class="flex items-center gap-2">
        <div class="size-12 rounded bg-ember-500/25"></div>
        <div class="size-12 rounded bg-ember-500/50"></div>
        <div class="size-12 rounded bg-ember-500/75"></div>
        <div class="size-12 rounded bg-ember-500"></div>
        <span class="text-xs text-ink-500">ember-500 at 25 / 50 / 75 / 100</span>
    </div>
    <p class="text-sm text-ink-900/60">text-ink-900/60 for secondary copy.</p>
    <div class="flex items-center gap-2">
        <div class="size-12 rounded border border-ink-200 bg-[#e05d42]/40"></div>
        <span class="text-xs text-ink-500">arbitrary color with modifier: bg-[#e05d42]/40</span>
    </div>
</DemoSection>

<DemoSection Title="The opacity utility" Note="opacity-* applies to the whole element.">
    <div class="flex items-center gap-2">
        <div class="size-12 rounded bg-ocean-600 opacity-10"></div>
        <div class="size-12 rounded bg-ocean-600 opacity-25"></div>
        <div class="size-12 rounded bg-ocean-600 opacity-50"></div>
        <div class="size-12 rounded bg-ocean-600 opacity-75"></div>
        <div class="size-12 rounded bg-ocean-600 opacity-100"></div>
        <span class="text-xs text-ink-500">opacity-10 &rarr; opacity-100</span>
    </div>
</DemoSection>

<DemoSection Title="Background properties" Note="position, size, repeat and clip, demonstrated with a small SVG tile.">
    <div class="grid gap-3 sm:grid-cols-2">
        <div class="h-24 rounded-lg border border-ink-200 bg-center bg-no-repeat bg-ocean-100 bg-[url('data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%2748%27%20height=%2748%27%3E%3Ccircle%20cx=%2724%27%20cy=%2724%27%20r=%2712%27%20fill=%27%232f6bc6%27/%3E%3C/svg%3E')]"></div>
        <div class="h-24 rounded-lg border border-ink-200 bg-repeat bg-left-top bg-amber-50 bg-[image:var(--tile)] [--tile:url('data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%2748%27%20height=%2748%27%3E%3Ccircle%20cx=%2724%27%20cy=%2724%27%20r=%2712%27%20fill=%27%23e6ad0f%27/%3E%3C/svg%3E')]"></div>
        <div class="h-24 rounded-lg border border-ink-200 bg-cover bg-center bg-forest-100" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2296%22 height=%2296%22%3E%3Crect width=%2296%22 height=%2296%22 fill=%22%2347ae81%22/%3E%3C/svg%3E')"></div>
        <div class="h-24 rounded-lg border border-ink-200 bg-contain bg-rose-100" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2296%22 height=%2296%22%3E%3Crect width=%2296%22 height=%2296%22 fill=%22%23c13359%22/%3E%3C/svg%3E')"></div>
    </div>
    <div class="rounded-lg border border-ink-200 p-3">
        <p class="bg-clip-text text-lg font-bold text-transparent" style="background-image:linear-gradient(90deg,#2f6bc6,#47ae81)">
            bg-clip-text + text-transparent with a gradient image.
        </p>
    </div>
</DemoSection>

<DemoSection Title="Background blending" Note="bg-blend composites the image with the background color.">
    <div class="flex flex-wrap gap-3">
        <div class="size-24 rounded-lg bg-ocean-500 bg-cover mix-blend-normal" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2296%22 height=%2296%22%3E%3Ccircle cx=%2248%22 cy=%2248%22 r=%2230%22 fill=%22white%22/%3E%3C/svg%3E')"></div>
        <div class="size-24 rounded-lg bg-ocean-500 bg-cover bg-blend-multiply" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2296%22 height=%2296%22%3E%3Ccircle cx=%2248%22 cy=%2248%22 r=%2230%22 fill=%22white%22/%3E%3C/svg%3E')"></div>
        <div class="size-24 rounded-lg bg-ocean-500 bg-cover bg-blend-screen" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2296%22 height=%2296%22%3E%3Ccircle cx=%2248%22 cy=%2248%22 r=%2230%22 fill=%22black%22/%3E%3C/svg%3E')"></div>
        <div class="size-24 rounded-lg bg-ocean-500 bg-cover bg-blend-luminosity" style="background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2296%22 height=%2296%22%3E%3Ccircle cx=%2248%22 cy=%2248%22 r=%2230%22 fill=%22white%22/%3E%3C/svg%3E')"></div>
    </div>
    <p class="text-xs text-ink-500">plain, bg-blend-multiply, bg-blend-screen, bg-blend-luminosity.</p>
</DemoSection>
