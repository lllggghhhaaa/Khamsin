@page "/colors"

<PageTitle>Colors &middot; Khamsin sample</PageTitle>

<div class="mb-8">
    <h1 class="text-2xl font-bold text-ink-900">Colors and backgrounds</h1>
    <p class="mt-1 text-sm text-ink-500">
        The built-in palette, every color target, opacity modifiers, arbitrary and CSS-variable colors,
        blending and background properties.
    </p>
</div>

<DemoSection Title="The ink ramp" Note="Neutral grays used across the whole sample.">
    <div class="flex gap-1">
        <div class="size-12 rounded bg-ink-50"></div>
        <div class="size-12 rounded bg-ink-100"></div>
        <div class="size-12 rounded bg-ink-200"></div>
        <div class="size-12 rounded bg-ink-300"></div>
        <div class="size-12 rounded bg-ink-400"></div>
        <div class="size-12 rounded bg-ink-500"></div>
        <div class="size-12 rounded bg-ink-600"></div>
        <div class="size-12 rounded bg-ink-700"></div>
        <div class="size-12 rounded bg-ink-800"></div>
        <div class="size-12 rounded bg-ink-900"></div>
        <div class="size-12 rounded bg-ink-950"></div>
    </div>
    <p class="text-xs text-ink-500">ink-50 &rarr; ink-950</p>
</DemoSection>

